# Copy this file to .env and fill in your values.
# Never commit the real .env file.

# Database
DB_HOST=localhost
DB_NAME=cect_db
DB_USER=root
DB_PASS=

# Google OAuth (from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/cect_system/pages/google-callback.php

# ToyyibPay (use sandbox for development)
TOYYIBPAY_SECRET_KEY=
TOYYIBPAY_CATEGORY_CODE=
TOYYIBPAY_API_URL=https://dev.toyyibpay.com/

# SMTP (e.g. Brevo)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls

# Mail defaults
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=CECT System

# Optional: force base URL (leave empty to detect from request)
APP_BASE_URL=
